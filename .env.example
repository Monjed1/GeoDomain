NODE_ENV=production
PORT=3232
TRUST_PROXY=false

# Optional. If set, clients must send Authorization: Bearer followed by this value.
API_KEY=

# For local Node.js without Docker: redis://localhost:6379
# Docker Compose overrides this to redis://redis:6379 automatically.
REDIS_URL=redis://localhost:6379

CACHE_TTL_SECONDS=3600
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
MAX_GENERATE_COUNT=10
MAX_DOMAIN_ROOT_LENGTH=20
DOMAIN_GENERATION_ATTEMPTS=1600
